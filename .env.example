# ============================================
# Fairy - Docker Compose Environment Variables
# ============================================
# Copy this file to .env and fill in the values
# このファイルを .env にコピーして値を設定してください

# ============================================
# Common / 共通
# ============================================
APP_VERSION=v2.3.0

# ============================================
# Backend API (fairy-backend-api)
# ============================================
GEMINI_API_KEY=your_gemini_api_key
JWT_SECRET=your_jwt_secret
MONGODB_URI=mongodb://fairy-mongodb:27017
BASE_URL=https://api-fairy.krz-tech.net
FRONTEND_URL=https://fairy.krz-tech.net
CORS_ORIGINS=https://fairy.krz-tech.net,http://localhost:5173

# ============================================
# Backend Bot (fairy-backend-bot)
# ============================================
DISCORD_BOT_TOKEN=your_discord_bot_token

# Internal cluster service URL (Docker Compose / K8s internal)
# クラスタ内部サービスURL（Docker Compose / K8s 内部通信用）
BACKEND_INTERNAL_URL=http://fairy-backend-api:8000

# ============================================
# Frontend (fairy-frontend)
# ============================================
# External backend URL for OGP proxy (nginx redirect)
# 外部バックエンドURL（OGPプロキシ用、nginxリダイレクト）
BACKEND_API_URL=https://api-fairy.krz-tech.net
VITE_DISCORD_INVITE_URL=https://discord.gg/your_invite_code
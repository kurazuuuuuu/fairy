# ============================================
# Fairy Backend API - Environment Variables
# ============================================

# --- Required / 必須 ---
GEMINI_API_KEY=your_gemini_api_key
JWT_SECRET=your_jwt_secret
MONGODB_URI=mongodb://localhost:27017
BASE_URL=https://api-fairy.krz-tech.net
FRONTEND_URL=https://fairy.krz-tech.net

# --- Optional / オプション ---
CORS_ORIGINS=https://fairy.krz-tech.net,http://localhost:5173